<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="4.2.1"/>
  <template class="GdnThreadView" parent="GtkBox">
    <child>
      <object class="GtkScrolledWindow" id="scrolled_window">
        <property name="hexpand">True</property>
        <property name="vexpand">True</property>
        <child>
          <object class="GtkColumnView" id="column_view">
            <child>
              <object class="GtkColumnViewColumn" id="name_col">
                <property name="title">Thread</property>
                <property name="resizable">True</property>
                <property name="fixed-width">160</property>
              </object>
            </child>
            <child>
              <object class="GtkColumnViewColumn" id="procedure_col">
                <property name="title">Started with</property>
                <property name="resizable">True</property>
                <property name="expand">True</property>
              </object>
            </child>
            <child>
              <object class="GtkColumnViewColumn" id="state_col">
                <property name="title">State</property>
                <property name="resizable">True</property>
                <property name="fixed-width">180</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
